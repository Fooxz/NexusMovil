# Copiar a supabase/functions/.env (ignorado por git) y completar. Guardar sin BOM.
# En producción, los mismos valores con: npx supabase secrets set --env-file supabase/functions/.env

# Asistente (fase 7)
GEMINI_API_KEY=
# GEMINI_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite

# Pagos con Wompi (fase 8). Dashboard de Wompi > Desarrolladores, en modo de pruebas.
WOMPI_PUBLIC_KEY=pub_test_
WOMPI_INTEGRITY_SECRET=test_integrity_
WOMPI_EVENTS_SECRET=test_events_
# Opcional: permite consultar el pago por referencia si la app no recibió el id.
WOMPI_PRIVATE_KEY=
# Página de regreso después de pagar. En local la app la intercepta, así que
# basta con esta; en la nube, por defecto es la función checkout.
CHECKOUT_RETURN_URL=http://127.0.0.1:54321/functions/v1/checkout
